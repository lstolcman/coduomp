/.workbench/
/build/
/run/

# Third-party sources fetched into libs/ on the first configure. Only the
# aggregator is tracked; delete a directory to have it fetched again.
/libs/*
!/libs/CMakeLists.txt

.DS_Store
__pycache__/
*.pyc

# Local game installation used for manual client and server runs.
/_GAME/

*.o
*.d
*.a
*.so
*.dylib
*.dll
*.exe
