# Default to Miniaudio on both architectures; retail Miles remains an x86 option.
# Generate an import library from the user's DLL; never fetch or bundle it.
if(NOT CODUOMP_BUILD_CLIENT)
    return()
endif()
set(CODUOMP_AUDIO_BACKEND miniaudio CACHE STRING "Client audio backend: miniaudio or miles (x86 only)")
set_property(CACHE CODUOMP_AUDIO_BACKEND PROPERTY STRINGS miniaudio miles)
if(NOT CODUOMP_AUDIO_BACKEND MATCHES "^(miniaudio|miles)$")
    message(FATAL_ERROR "CODUOMP_AUDIO_BACKEND must be miniaudio or miles.")
endif()
message(STATUS "Client audio backend: ${CODUOMP_AUDIO_BACKEND}")
if(CODUOMP_AUDIO_BACKEND STREQUAL "miniaudio")
    set(CODUOMP_AUDIO_DEFINITION AUDIO_BACKEND_MINIAUDIO)
    return()
endif()
if(NOT CODUOMP_32BIT_X86)
    message(FATAL_ERROR "The Miles audio backend requires an x86 build; use miniaudio on x64.")
endif()

set(MSS32_DLL "" CACHE FILEPATH "User-supplied retail i386 mss32.dll")
if(NOT EXISTS "${MSS32_DLL}")
    message(FATAL_ERROR "The Miles audio backend requires -DMSS32_DLL=<retail mss32.dll>.")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${MSS32_DLL}")
execute_process(COMMAND "${CMAKE_LINKER}" /dump /headers /exports "${MSS32_DLL}"
    RESULT_VARIABLE _mss_result OUTPUT_VARIABLE _mss_dump ERROR_VARIABLE _mss_error)
if(NOT _mss_result EQUAL 0 OR NOT _mss_dump MATCHES "14C machine \\(x86\\)")
    message(FATAL_ERROR "MSS32_DLL is not an inspectable i386 DLL: ${_mss_error}")
endif()
# LIB prefixes i386 public symbols with an underscore. Use names without that
# leading underscore plus the supplied DLL's actual ordinals, so LIB neither doubles
# the symbol prefix nor removes the underscore from a runtime import name.
string(REGEX MATCHALL "[0-9]+[ \t]+[0-9A-Fa-f]+[ \t]+[0-9A-Fa-f]+[ \t]+_AIL_[A-Za-z0-9_]+@[0-9]+" _mss_rows "${_mss_dump}")
set(_mss_exports "")
set(_mss_names "")
foreach(_mss_row IN LISTS _mss_rows)
    if(_mss_row MATCHES "^([0-9]+)[ \t]+[0-9A-Fa-f]+[ \t]+[0-9A-Fa-f]+[ \t]+_(AIL_[A-Za-z0-9_]+@[0-9]+)$")
        list(APPEND _mss_exports "${CMAKE_MATCH_2} @${CMAKE_MATCH_1} NONAME")
        list(APPEND _mss_names "${CMAKE_MATCH_2}")
    endif()
endforeach()
if(NOT "AIL_startup@0" IN_LIST _mss_names)
    message(FATAL_ERROR "MSS32_DLL does not expose the expected Miles stdcall API.")
endif()
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
set(_mss_def "${CMAKE_BINARY_DIR}/lib/mss32.generated.def")
set(_mss_lib "${CMAKE_BINARY_DIR}/lib/mss32.lib")
string(JOIN "\n    " _mss_export_lines ${_mss_exports})
file(WRITE "${_mss_def}" "LIBRARY mss32.dll\nEXPORTS\n    ${_mss_export_lines}\n")
execute_process(COMMAND "${CMAKE_AR}" /nologo /machine:x86 "/def:${_mss_def}" "/out:${_mss_lib}"
    RESULT_VARIABLE _mss_result OUTPUT_VARIABLE _mss_output ERROR_VARIABLE _mss_error)
if(NOT _mss_result EQUAL 0)
    message(FATAL_ERROR "Could not create the Miles import library: ${_mss_output}${_mss_error}")
endif()
add_library(coduomp_miles INTERFACE)
target_link_libraries(coduomp_miles INTERFACE "${_mss_lib}")
set(CODUOMP_AUDIO_DEFINITION AUDIO_BACKEND_MILES)
set(CODUOMP_AUDIO_LIBRARIES coduomp_miles)
