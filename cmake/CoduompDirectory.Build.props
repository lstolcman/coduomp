<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- CMake maps its parallel build option to MSBuild /m or /m:N.
       Spend that budget on source files within each MSVC project, keeping
       project references sequential so the two budgets do not multiply.
       /FS coordinates writes to the compiler PDB during parallel compiles.
       Without /m, leave the compiler and project scheduling defaults alone. -->
  <PropertyGroup Condition="'$(MSBuildNodeCount)' != '' and '$(MSBuildNodeCount)' &gt; '1'">
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(MSBuildNodeCount)' != '' and '$(MSBuildNodeCount)' &gt; '1'">
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <ProcessorNumber>$(MSBuildNodeCount)</ProcessorNumber>
      <AdditionalOptions>%(AdditionalOptions) /FS</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
